# Test-time env for the Vite frontend.
#
# Vitest loads `.env.test` automatically. These values keep the test suite
# pinned to a dev (relative, non-https) API base and the dev CSRF cookie
# name, regardless of what the developer has in `frontend/.env` for local
# production-mode testing.
#
# Without this file, a `frontend/.env` that ships an https URL (e.g. for
# local production testing) makes `src/api/client.js` infer the production
# CSRF cookie name (`__Secure-csrf_token`), while the test files throughout
# the suite hardcode the dev name (`csrf_token`) in their mocks. The suite
# then fails with "expected undefined to be 'token-abc'" on every CSRF
# assertion, which reads like a client bug but is really a config mismatch.
#
# If a test file needs different values, it can override them with
# `vi.stubEnv` inside `beforeEach` (see `src/api/client.test.js`).

# Relative, so `document.cookie` in jsdom is same-origin and the fetch mock
# sees `/api/v1/...` URLs that match the tests' `API = '/api/v1'` constant.
VITE_API_BASE_URL=/api/v1

# Dev CSRF cookie name. Production uses `__Secure-csrf_token`.
VITE_CSRF_COOKIE_NAME=csrf_token
