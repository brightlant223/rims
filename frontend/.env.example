# Ruchita Interiors - frontend environment template.
# Copy this file to .env and adjust as needed. Never commit .env.

# Base URL of the backend API, including the version prefix.
#
# Two supported shapes:
#   1. Relative path (dev, and single-origin production): /api/v1
#      The Vite dev server proxies /api to Flask (see vite.config.js).
#   2. Absolute URL (split-origin production, e.g. Netlify -> PythonAnywhere):
#      https://<your-backend-host>/api/v1
#
# Whichever shape you use, the client (src/api/client.js) enforces the
# `/api/v1` suffix itself: a value that ships without the prefix (a common
# mistake, e.g. just `https://rqis.pythonanywhere.com`) is auto-corrected
# before any fetch is issued. See the 2026-10 audit, finding C1.
#
# Do NOT point this at an absolute URL without the /api/v1 suffix.
# Auth cookies are SameSite=None + Secure in production, and the frontend
# origin must be listed in CORS_ORIGINS on the backend. Both failures
# look identical in the browser: every request reports "Cannot reach the
# server" and login never completes.
VITE_API_BASE_URL=/api/v1

# For split-origin production (Netlify frontend -> PythonAnywhere backend):
#   VITE_API_BASE_URL=https://rqis.pythonanywhere.com/api/v1
# And make sure the backend has:
#   CORS_ORIGINS=https://rqis.netlify.app,https://app.ruchitainteriors.in
#   FLASK_ENV=production
#   TRUST_PROXY_HEADERS=true
